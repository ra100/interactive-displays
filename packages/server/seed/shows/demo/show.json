        }
      }
    },
    {
      "id": "eps.load",
      "label": "EPS load",
      "unit": "%",
      "scope": "ambient",
      "source": {
        "kind": "walk",
        "min": 40,
        "max": 80,
        "volatility": 0.4
      },
      "byState": {
        "damaged": {
          "min": 75,
          "max": 99,
          "volatility": 0.9
        }
      }
    },
    {
      "id": "coolant.temp",
      "label": "Coolant temperature",
      "unit": "K",
