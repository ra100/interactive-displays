                      "type": "widget",
                      "kind": "ship-schematic",
                      "props": {
                        "label": "U.S.S. Minas Tirith",
                        "view": "side",
                        "mode": "engineering",
                        "tone": "info"
                      },
                      "bind": {
                        "power": {
                          "signal": "warp.output"
                        }
                      },
                      "when": [
                        {
                          "state": "damaged",
                          "props": {
                            "mode": "damage",
                            "damaged": [
                              "nacelles",
