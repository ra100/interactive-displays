      },
      {
        "weight": 1,
        "node": {
          "id": "sections",
          "type": "container",
          "layout": { "kind": "stack", "direction": "row", "gap": "medium" },
          "children": [
            { "node": { "id": "engineering", "type": "widget", "kind": "button", "props": { "label": "Engineering" } } },
            { "node": { "id": "tactical", "type": "widget", "kind": "button", "props": { "label": "Tactical", "tone": "danger" } } },
            { "node": { "id": "science", "type": "widget", "kind": "button", "props": { "label": "Science", "tone": "info" } } }
          ]
        }
      }
    ]
  }
