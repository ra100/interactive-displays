{
  "schemaVersion": 1,
  "id": "welcome",
  "name": "Welcome",
  "tags": ["demo"],
  "profile": { "aspect": "16:9", "fit": "fluid" },
  "root": {
    "id": "root",
    "type": "container",
    "layout": { "kind": "stack", "direction": "column", "gap": "large" },
