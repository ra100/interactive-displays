{
  "id": "medical",
  "label": "Medical",
  "description": "Sickbay: patient vitals, biobeds and the medical computer.",
  "code": "MED",
  "archetypes": {
    "dashboard": 3,
    "sidebar": 2,
    "header-main": 1,
    "split": 1
  },
  "titles": [
    "SICKBAY",
    "MEDICAL STATUS",
    "PATIENT MONITOR"
  ],
  "nav": [
    "BIOBED 1",
    "BIOBED 2",
    "VITALS",
    "PHARMACY",
    "QUARANTINE",
    "DATABASE",
    "LOGS"
  ],
  "status": [
    "PATIENT STABLE",
    "BIOBED MONITORS ACTIVE",
    "QUARANTINE FIELD STANDING BY"
  ],
  "systems": [
    {
      "id": "vitals",
      "label": "VITAL SIGNS",
      "short": "VITALS",
      "metrics": [
        {
          "id": "heart",
          "label": "HEART RATE",
          "unit": "bpm",
          "range": [
            62,
            78
          ],
          "alertRange": [
            130,
            170
          ],
          "motion": "wave",
          "prefer": [
            "sparkline",
            "readout"
          ]
        },
        {
          "id": "bp",
          "label": "BLOOD PRESSURE",
          "unit": "mmHg",
          "range": [
            110,
            125
          ],
          "alertRange": [
            70,
            90
          ],
          "prefer": [
            "readout"
          ]
        },
        {
          "id": "neural",
          "label": "NEURAL ACTIVITY",
          "unit": "%",
          "range": [
            55,
            70
          ],
          "alertRange": [
            10,
            30
          ],
          "motion": "wave",
          "prefer": [
            "sparkline"
          ]
        },
        {
          "id": "temp",
          "label": "BODY TEMP",
          "unit": "C",
          "range": [
            36.5,
            37.2
          ],
          "precision": 1,
          "prefer": [
            "readout"
          ]
        }
      ],
      "actions": [
        {
          "label": "CORTICAL STIM",
          "danger": true
        },
        {
          "label": "ADMINISTER 5CC"
        }
      ],
      "notes": [
        "Synaptic patterns within normal parameters"
      ]
    },
    {
      "id": "biobed",
      "label": "BIOBED",
      "metrics": [
        {
          "id": "scan",
          "label": "SCAN DEPTH",
          "unit": "%",
          "range": [
            80,
            100
          ],
          "prefer": [
            "gauge"
          ]
        },
        {
          "id": "field",
          "label": "STASIS FIELD",
          "unit": "%",
          "range": [
            0,
            5
          ]
        }
      ],
      "actions": [
        {
          "label": "FULL SCAN"
        },
        {
          "label": "STASIS",
          "danger": true
        }
      ]
    },
    {
      "id": "quarantine",
      "label": "QUARANTINE",
      "metrics": [
        {
          "id": "seal",
          "label": "FORCE FIELD",
          "unit": "%",
          "range": [
            98,
            100
          ],
          "alertRange": [
            40,
            70
          ],
          "prefer": [
            "gauge"
          ]
        },
        {
          "id": "pathogen",
          "label": "PATHOGEN COUNT",
          "range": [
            0,
            3
          ],
          "alertRange": [
            40,
            90
          ],
          "prefer": [
            "readout"
          ],
          "precision": 0
        }
      ],
      "actions": [
        {
          "label": "SEAL SICKBAY",
          "danger": true
        },
        {
          "label": "DECONTAMINATE"
        }
      ]
    }
  ],
  "blocks": {
    "prefer": [
      "trend-panel",
      "readout-column",
      "status-board"
    ],
    "avoid": [
      "gauge-bank"
    ]
  },
  "alert": {
    "banner": true,
    "emphasise": [
      "heart",
      "neural",
      "pathogen"
    ],
    "status": [
      "PATIENT CRASHING",
      "QUARANTINE BREACH"
    ]
  },
  "tags": [
    "medical",
    "patient",
    "health",
    "vitals"
  ]
}
