{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    "packages/server": {
      "ignore": ["src/validation.ts"]
    },
    "packages/app": {
      "entry": ["src/main.tsx"]
    },
    "packages/shared": {}
  },
  "ignore": [
    "**/*.config.ts",
    "**/*.config.js",
    ".history/**"
  ],
  "ignoreDependencies": [
    "@dnd-kit/core"
  ]
}
