{
  "name": "interactive-displays",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "format": "oxlint --fix",
    "typecheck": "pnpm -r run typecheck",
    "knip": "knip",
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:unit": "pnpm -r run test",
    "test:e2e": "playwright test",
    "test:watch": "pnpm -r --parallel run test:watch",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "husky": "^9.1.7",
    "knip": "^5.83.1",
    "lint-staged": "^16.2.7",
    "oxlint": "^1.43.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix"
    ]
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  }
}
