{
  "name": "interactive-displays",
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "format": "oxlint --fix",
    "typecheck": "pnpm -r run typecheck",
    "knip": "knip",
    "dev": "pnpm --parallel --filter @interactive-displays/server --filter @interactive-displays/app run dev",
    "build": "pnpm -r run build",
    "start": "pnpm --filter @interactive-displays/server start",
    "test": "pnpm -r run test",
    "test:unit": "pnpm -r run test",
    "test:e2e": "playwright test",
    "test:watch": "pnpm -r --parallel run test:watch",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix"
    ]
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.0.0"
  }
}
